<?xml version="1.0" encoding="utf-8"?><!--
   Chat sessions, session images, and API keys are excluded from backup so that
   restores never produce chats with missing images or expose credentials.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31.
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="session_images" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?><!--
   Chat sessions, session images, and API keys are excluded from cloud backup and
   device transfer so that restores never produce chats with missing images or
   expose credentials. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="session_images" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="session_images" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
